GOOGLE_SHEETS_SPREADSHEET_ID=17eh6UcqJOFXWKPnMI_8rebyJG5tBGo6irShykmKzP9A
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Alternative to GOOGLE_PRIVATE_KEY if multiline env values are annoying:
# GOOGLE_PRIVATE_KEY_BASE64=base64_encoded_private_key

# Optional app password for deployed access.
KATLAS_APP_PASSWORD=choose_a_private_password

# OpenRouter AI provider. Server-side only, never expose this with a VITE_ prefix.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_key
OPENROUTER_DEFAULT_MODEL=openrouter_model_id
OPENROUTER_FALLBACK_MODEL=optional_fallback_model_id
OPENROUTER_HTTP_REFERER=https://your-production-domain.com

# Optional translation provider.
TRANSLATION_PROVIDER=google
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key

# Bulk Sender Gmail OAuth. Server-side only, never expose these with a VITE_ prefix.
# The refresh token must be granted both gmail.compose and gmail.settings.basic scopes.
GMAIL_CLIENT_ID=your_google_oauth_client_id
GMAIL_CLIENT_SECRET=your_google_oauth_client_secret
GMAIL_REFRESH_TOKEN=your_google_oauth_refresh_token

# Google Calendar OAuth. Create a Web application OAuth client in Google Cloud.
# Local authorized redirect URI: http://localhost:8080/api/calendar/oauth/callback
GOOGLE_CALENDAR_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CALENDAR_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8080/api/calendar/oauth/callback
# Generate a long random value. It encrypts the browser's calendar refresh token.
GOOGLE_CALENDAR_TOKEN_SECRET=replace_with_a_long_random_secret

# Billy's Scraper System uses the free public TikTok hashtag page route.
# No TikTok API key, TikTok client secret, paid scraper API, or AI key is required for Billy.
